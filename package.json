{
  "name": "pm-presets",
  "version": "2026.8.22",
  "description": "All 7 official pm-cli workspace presets in one package: bug-triage, indie-dev, open-source, software-sprint, startup-roadmap, kanban, agent-workflow",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unbraind/pm-presets.git"
  },
  "bugs": {
    "url": "https://github.com/unbraind/pm-presets/issues"
  },
  "homepage": "https://github.com/unbraind/pm-presets#readme",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "default": "./dist/registry.js"
    }
  },
  "files": [
    "dist/",
    "manifest.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck",
    "docstring": "node scripts/docstring-gate.ts",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build && npm run build:test && node --test tests/*.test.ts",
    "audit:prod": "node --input-type=module -e \"import { spawnSync } from 'node:child_process'; import { devNull } from 'node:os'; const env = { ...process.env, npm_config_userconfig: devNull, NPM_CONFIG_USERCONFIG: devNull }; for (const key of Object.keys(env)) if (key.toLowerCase() === 'npm_config_allow_scripts') delete env[key]; const win = process.platform === 'win32'; const r = spawnSync(win ? 'npm.cmd' : 'npm', ['audit', '--omit=dev', '--ignore-scripts'], { stdio: 'inherit', env, shell: win }); process.exit(r.status ?? 1);\"",
    "pack:dry-run": "npm pack --dry-run",
    "changelog": "pm-changelog --pm-root .agents/pm --mode prepend --output CHANGELOG.md --release-version-from-package --since-previous-tag --until-release-tag --item-url-base https://github.com/unbraind/pm-presets/blob/main/.agents/pm --respect-item-release --pm-bin ./node_modules/.bin/pm --pm-arg=--output-budget --pm-arg=unbounded --pm-arg=--output-limit --pm-arg=unbounded",
    "changelog:full": "pm-changelog --pm-root .agents/pm --mode replace --output CHANGELOG.md --all-release-tags --release-version-from-package --item-url-base https://github.com/unbraind/pm-presets/blob/main/.agents/pm --respect-item-release --pm-bin ./node_modules/.bin/pm --pm-arg=--output-budget --pm-arg=unbounded --pm-arg=--output-limit --pm-arg=unbounded",
    "changelog:check": "pm-changelog --pm-root .agents/pm --mode replace --output CHANGELOG.md --all-release-tags --release-version-from-package --item-url-base https://github.com/unbraind/pm-presets/blob/main/.agents/pm --respect-item-release --check --pm-bin ./node_modules/.bin/pm --pm-arg=--output-budget --pm-arg=unbounded --pm-arg=--output-limit --pm-arg=unbounded",
    "release:check": "npm run check && npm run docstring && npm run coverage && npm run audit:prod && npm run pack:dry-run && npm run changelog:check",
    "prepublishOnly": "npm run release:check",
    "release:notes": "pm-changelog --pm-root .agents/pm --stdout --since-previous-tag --until-release-tag --release-version-from-package --item-url-base https://github.com/unbraind/pm-presets/blob/main/.agents/pm --respect-item-release --pm-bin ./node_modules/.bin/pm --github-step-summary --pm-arg=--output-budget --pm-arg=unbounded --pm-arg=--output-limit --pm-arg=unbounded",
    "prepare": "node scripts/prepare-merge-driver.ts",
    "merge:install": "pm merge install",
    "coverage": "npm run build && npm run build:test && node scripts/coverage-gate.ts"
  },
  "peerDependencies": {
    "@unbrained/pm-cli": ">=2026.8.7"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@unbrained/pm-cli": "2026.8.17",
    "pm-changelog": "^2026.8.7",
    "pm-ops": "2026.8.17",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "author": "@unbraind",
  "license": "MIT",
  "keywords": [
    "agent-setup",
    "agent-workflow",
    "ai-agent",
    "bug-triage",
    "indie-dev",
    "kanban",
    "open-source",
    "pm-cli",
    "pm-package",
    "pm-preset",
    "pm-presets",
    "preset",
    "software-sprint",
    "startup-roadmap",
    "workspace"
  ],
  "pm": {
    "aliases": [
      "presets",
      "bug-triage",
      "indie-dev",
      "open-source",
      "software-sprint",
      "startup-roadmap",
      "agent-workflow",
      "agent-setup"
    ],
    "extensions": [
      "."
    ],
    "catalog": {
      "display_name": "pm Presets",
      "category": "preset",
      "summary": "All 7 official pm-cli workspace presets in one package: bug-triage, indie-dev, open-source, software-sprint, startup-roadmap, kanban, agent-workflow",
      "tags": [
        "preset",
        "official",
        "bug-triage",
        "indie-dev",
        "kanban",
        "open-source",
        "software-sprint",
        "startup-roadmap",
        "agent-workflow",
        "agent-setup"
      ],
      "links": {
        "docs": "https://github.com/unbraind/pm-presets#readme",
        "npm": "https://www.npmjs.com/package/pm-presets",
        "repository": "https://github.com/unbraind/pm-presets",
        "report": "https://github.com/unbraind/pm-presets/issues"
      }
    },
    "docs": [
      "README.md",
      "CHANGELOG.md"
    ],
    "examples": [
      "README.md"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "coverageGate": {
    "sources": [
      "src",
      "scripts/prepare-merge-driver.ts",
      "scripts/docstring-gate.ts"
    ],
    "tests": [
      "tests/*.test.ts"
    ],
    "thresholds": {
      "lines": 75,
      "branches": 83,
      "functions": 64
    },
    "ignore": []
  }
}
