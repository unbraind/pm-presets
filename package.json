{
  "name": "pm-presets",
  "version": "2026.11.13",
  "description": "All 7 official pm-cli workspace presets in one package: bug-triage, indie-dev, open-source, software-sprint, startup-roadmap, kanban, agent-workflow",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unbraind/pm-presets.git"
  },
  "bugs": {
    "url": "https://github.com/unbraind/pm-presets/issues"
  },
  "homepage": "https://pm-cli.unbrained.dev/packages/pm-presets",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "default": "./dist/registry.js"
    }
  },
  "files": [
    "dist/",
    "manifest.json",
    "README.md",
    "CHANGELOG.md",
    "presets.json",
    "docs/simulation-example.md",
    "docs/upgrade-example.md",
    "docs/plan-example.md",
    "docs/stack-example.md",
    "docs/params-example.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck",
    "docstring": "node scripts/docstring-gate.ts",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build && npm run build:test && node --test tests/*.test.ts",
    "audit:prod": "node scripts/audit-prod.ts",
    "pack:dry-run": "npm pack --dry-run",
    "changelog": "pm-changelog --pm-root .agents/pm --mode prepend --output CHANGELOG.md --release-version-from-package --date-from-version --since-previous-tag --until-release-tag --item-url-base https://github.com/unbraind/pm-presets/blob/main/.agents/pm --respect-item-release --exclude-tag upstream --pm-arg=--output-budget --pm-arg=unbounded --pm-arg=--output-limit --pm-arg=unbounded",
    "changelog:full": "pm-changelog --pm-root .agents/pm --mode replace --output CHANGELOG.md --all-release-tags --release-version-from-package --date-from-version --item-url-base https://github.com/unbraind/pm-presets/blob/main/.agents/pm --respect-item-release --exclude-tag upstream --pm-arg=--output-budget --pm-arg=unbounded --pm-arg=--output-limit --pm-arg=unbounded",
    "changelog:check": "node scripts/check-changelog.ts --pm-root .agents/pm --mode replace --output CHANGELOG.md --all-release-tags --release-version-from-package --date-from-version --item-url-base https://github.com/unbraind/pm-presets/blob/main/.agents/pm --respect-item-release --exclude-tag upstream --check --pm-arg=--output-budget --pm-arg=unbounded --pm-arg=--output-limit --pm-arg=unbounded",
    "release:check": "npm run check && npm run lint && npm run docstring && npm run coverage && npm run audit:prod && npm run pack:dry-run && npm run verify:closeout-attribution && npm run changelog:check && npm run verify:release-publish-attestation && npm run verify:release-changelog-date",
    "prepublishOnly": "npm run release:check && npm run changelog:check:release",
    "release:notes": "pm-changelog --pm-root .agents/pm --stdout --since-previous-tag --until-release-tag --release-version-from-package --date-from-version --item-url-base https://github.com/unbraind/pm-presets/blob/main/.agents/pm --respect-item-release --exclude-tag upstream --github-step-summary --pm-arg=--output-budget --pm-arg=unbounded --pm-arg=--output-limit --pm-arg=unbounded",
    "prepare": "node scripts/prepare-merge-driver.ts",
    "merge:install": "pm merge install",
    "coverage": "npm run build && npm run build:test && node scripts/coverage-gate.ts",
    "verify:release-publish-attestation": "node scripts/verify-release-publish-attestation.ts",
    "verify:release-changelog-date": "node scripts/verify-release-changelog-date.ts",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "verify:closeout-attribution": "node scripts/verify-closeout-attribution.ts",
    "closeout:check": "npm run verify:closeout-attribution && npm run changelog:full -- --no-pending-release",
    "changelog:check:release": "pm-changelog --pm-root .agents/pm --mode replace --output CHANGELOG.md --all-release-tags --release-version-from-package --date-from-version --item-url-base https://github.com/unbraind/pm-presets/blob/main/.agents/pm --respect-item-release --exclude-tag upstream --check --pm-arg=--output-budget --pm-arg=unbounded --pm-arg=--output-limit --pm-arg=unbounded"
  },
  "peerDependencies": {
    "@unbrained/pm-cli": ">=2026.10.25"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@unbrained/pm-cli": "2026.11.9",
    "pm-changelog": "2026.11.7",
    "pm-ops": "2026.11.6",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "author": {
    "name": "unbrained",
    "url": "https://unbrained.dev/about"
  },
  "license": "MIT",
  "keywords": [
    "agent-setup",
    "agent-workflow",
    "ai-agent",
    "bug-triage",
    "indie-dev",
    "kanban",
    "open-source",
    "pm-cli",
    "pm-package",
    "pm-preset",
    "pm-presets",
    "preset",
    "software-sprint",
    "startup-roadmap",
    "workspace"
  ],
  "pm": {
    "aliases": [
      "presets",
      "bug-triage",
      "indie-dev",
      "open-source",
      "software-sprint",
      "startup-roadmap",
      "agent-workflow",
      "agent-setup"
    ],
    "extensions": [
      "."
    ],
    "catalog": {
      "display_name": "pm Presets",
      "category": "preset",
      "summary": "All 7 official pm-cli workspace presets in one package: bug-triage, indie-dev, open-source, software-sprint, startup-roadmap, kanban, agent-workflow",
      "tags": [
        "preset",
        "official",
        "bug-triage",
        "indie-dev",
        "kanban",
        "open-source",
        "software-sprint",
        "startup-roadmap",
        "agent-workflow",
        "agent-setup"
      ],
      "links": {
        "docs": "https://github.com/unbraind/pm-presets#readme",
        "npm": "https://www.npmjs.com/package/pm-presets",
        "repository": "https://github.com/unbraind/pm-presets",
        "report": "https://github.com/unbraind/pm-presets/issues"
      }
    },
    "docs": [
      "README.md",
      "CHANGELOG.md",
      "docs/simulation-example.md",
      "docs/upgrade-example.md",
      "docs/plan-example.md",
      "docs/stack-example.md"
    ],
    "examples": [
      "README.md",
      "docs/simulation-example.md",
      "docs/upgrade-example.md",
      "docs/plan-example.md",
      "docs/stack-example.md"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "coverageGate": {
    "sources": [
      "src",
      "scripts/prepare-merge-driver.ts",
      "scripts/docstring-gate.ts"
    ],
    "tests": [
      "tests/*.test.ts"
    ],
    "thresholds": {
      "lines": 100,
      "branches": 100,
      "functions": 100
    },
    "ignore": []
  }
}
