{"hash_algorithm":"sha256","ts":"2026-11-16T16:00:28.110Z","author":"codex-sol","author_source":"asserted","agent_harness":"codex","agent_model":"gpt-6.1-sol","agent_model_source":"probe","agent_instance":"39f99f2ff4dcd94b82f6169c","agent_provenance":{"model":{"value":"gpt-6.1-sol","source":"probe"},"effort":{"value":"high","source":"probe"},"role":{"value":"implementer","source":"argv"},"topic":null},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-a8is"},{"op":"add","path":"/metadata/title","value":"Keep changelog checks stable when Windows checks out CRLF text"},{"op":"add","path":"/metadata/description","value":"The sweep PR Windows documentation gate passed tracker health but failed both prepared-release and historical changelog checks. An isolated checkout of the exact pushed commit with core.autocrlf=true reproduced the failure (505 CRLF lines); checking out the same commit with LF made the unchanged npm run changelog:check pass. The generator compares exact bytes, while the repository has no canonical LF policy for CHANGELOG.md. A persistent fix requires repository attributes or generator/checker behavior, outside this tracker-only sweep."},{"op":"add","path":"/metadata/type","value":"Chore"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":2},{"op":"add","path":"/metadata/tags","value":["changelog","ci","gh:unbraind/pm-presets#218"]},{"op":"add","path":"/metadata/created_at","value":"2026-11-16T16:00:28.110Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-11-16T16:00:28.110Z"},{"op":"add","path":"/metadata/author","value":"codex-sol"},{"op":"add","path":"/metadata/estimated_minutes","value":30},{"op":"add","path":"/metadata/acceptance_criteria","value":"The same canonical generated changelog passes the unchanged check after ordinary Linux and Windows checkouts, with regression evidence for LF and CRLF checkout policy."}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939