      created_at: "2026-09-28T22:48:27.146Z"
      source_kind: local_mutation
      source_ref: chore/pm-presets-cli-sdk-2026-9-28
    note: Direct full package gate; tracked run context may differ from release environment
  - command: node --test tests/release-workflow.test.ts
    scope: project
    timeout_seconds: 120
