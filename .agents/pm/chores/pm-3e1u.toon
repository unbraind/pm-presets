tests[1]{command,path,scope}:
  PM_PATH=/tmp/pm-mv-pm-presets PM_GLOBAL_PATH=/tmp/pm-mv-g-pm-presets node --test tests/manifest-vocabulary.test.ts,tests/manifest-vocabulary.test.ts,project
close_reason: "Moved the preset catalog to presets.json (shipped in package files), updated tests/registry.test.ts to read it there, and removed the inert pm key from manifest.json. Pinned @unbrained/pm-cli at 2026.8.22. Regression test tests/manifest-vocabulary.test.ts verified to fail on re-adding an unknown key and pass after removal; npm test 74/74, release:check exit 0, pinned pm health --strict-exit exit 0."
body: ""
