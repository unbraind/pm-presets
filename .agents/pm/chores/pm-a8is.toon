  .gitattributes,project
  CHANGELOG.md,project
  scripts/check-changelog.ts,project
  tests/closeout-history.test.ts,project
tests[1]{command,scope,timeout_seconds,provenance{author,created_at,source_kind,source_ref}}:
  "npm run typecheck && npm run lint && npm run build:test && node --test tests/closeout-history.test.ts && npm run changelog:check",project,600,codex-sol,"2026-11-16T20:15:16.513Z",local_mutation,fix/changelog-check-crlf
